<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070809">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black">
<meta name="apple-mobile-web-app-title" content="倉位">
<link rel="manifest" href="/manifest.webmanifest?v=591">
<link rel="apple-touch-icon" href="/app-icon-180.png?v=591">
<title>倉位</title>
<style>
:root{
  color-scheme:dark;
  --bg:#070809;--card:#131414;--card2:#0c0e0f;--line:#4b3820;--line2:#262728;
  --gold:#d4a54b;--gold2:#edc46e;--text:#f2eee6;--muted:#89857d;
  --up:#ff5e60;--down:#4fd58a;--warn:#e5b858;--bad:#ff796e;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{
  margin:0;color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang TC",sans-serif;
  background:
    radial-gradient(circle at 14% -5%,rgba(214,163,72,.12),transparent 27%),
    linear-gradient(180deg,#070809 0%,#090b0c 60%,#070809 100%);
}
button,input{font:inherit}
.wrap{max-width:680px;margin:auto;min-height:100dvh;padding:calc(env(safe-area-inset-top) + 12px) 14px calc(46px + env(safe-area-inset-bottom))}

.top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin:0 2px 13px}
.brandTitle{font-size:23px;font-weight:900;color:#e3be70;letter-spacing:.2px}
.brandSub{font-size:11px;color:#77736b;margin-top:3px}
.sync{text-align:right}
.syncMain{font-size:11px;color:#b0aa9f}
.syncSub{font-size:9px;color:#706b63;margin-top:3px}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;background:#555}
.dot.ok{background:var(--gold);box-shadow:0 0 8px rgba(212,165,75,.38)}
.dot.warn{background:var(--warn)}.dot.bad{background:var(--bad)}

.latest{
  display:none;margin:9px 0 12px;padding:11px 12px;border-radius:14px;
  border:1px solid #5b431f;background:linear-gradient(120deg,#191817,#0d0e0f)
}
.latest.show{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center}
.latestTitle{font-size:13px;font-weight:850}.latestBody{font-size:11px;color:#bfb9ae;margin-top:3px}
.latestTime{font-size:9px;color:#777168}

.consensusPanel{
  display:none;margin:10px 0 13px;padding:12px;border:1px solid #6b4d20;border-radius:16px;
  background:linear-gradient(145deg,rgba(30,27,21,.98),rgba(12,13,14,.98))
}
.consensusPanel.show{display:block}
.panelTitle{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.panelTitle b{font-size:13px;color:#e3c27e}.panelTitle span{font-size:9px;color:#7c766b}
.consensusRow{display:grid;grid-template-columns:1fr auto;gap:10px;padding:9px 0;border-top:1px solid #29251d}
.consensusRow:first-of-type{border-top:0}
.consensusMain{min-width:0}
.consensusLine{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.consensusSymbol{font-size:14px;font-weight:850}
.dirBadge,.levelBadge,.statusBadge,.confidenceBadge{
  display:inline-block;border-radius:6px;padding:3px 6px;font-size:9px;font-weight:900
}
.dirBadge.long{background:#481c1d;color:#ff7778}.dirBadge.short{background:#123823;color:#63e39c}
.levelBadge.high{background:#4d3717;color:#f1c96d}.levelBadge.medium{background:#27251d;color:#d7c38b}.levelBadge.low{background:#222;color:#999}
.consensusMeta{font-size:9px;color:#7f796f;margin-top:4px}
.consensusScore{text-align:right;color:#e0bb68;font-size:13px;font-weight:850}
.consensusScore small{display:block;color:#777168;font-size:8px;font-weight:600;margin-top:2px}


.tradeCalc{margin:10px 0 12px;border:1px solid #493820;border-radius:14px;background:linear-gradient(145deg,#171716,#0d0e0f);overflow:hidden}
.tradeCalc>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;padding:12px 13px;cursor:pointer;color:#d8c49a;font-size:12px;font-weight:850}
.tradeCalc>summary::-webkit-details-marker{display:none}.tradeCalcHint{font-size:8px;color:#7b7469;font-weight:700}.tradeCalcBody{padding:0 11px 11px;border-top:1px solid #29251f}
.calcPositionPick{margin-top:10px}.calcPositionPick select{font-size:14px}.calcGrid{display:grid;grid-template-columns:1.15fr .85fr 1fr;gap:7px;margin-top:8px}.calcAutoGrid input[readonly]{color:#cfc7bb;background:#101112;border-color:#2b2c2e;cursor:default}
.calcModeRow{display:grid;grid-template-columns:1fr;gap:7px;margin-top:9px}.calcLead{display:grid;grid-template-columns:1fr .72fr 1fr;gap:7px;margin-top:8px}.calcPrices{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}
.calcField{min-width:0}.calcField label{display:block;color:#80786d;font-size:8px;font-weight:800;margin:0 0 4px 2px}.calcField input,.calcField select{width:100%;height:42px;border:1px solid #363534;border-radius:9px;background:#0c0d0e;color:#eee7dc;padding:0 9px;font-size:16px;font-weight:760;outline:none}.calcField input:focus,.calcField select:focus{border-color:#c99a45}.calcField input::placeholder{color:#55514b}.calcField select{appearance:auto}.calcField input:disabled{opacity:.48}.calcField input[readonly]{color:#cfc7bb;background:#101112}
.autoLevels{margin-top:9px;padding:9px;border:1px solid #302a20;border-radius:11px;background:#0b0c0d}.autoHead{display:flex;align-items:center;justify-content:space-between;gap:8px}.autoHead b{font-size:10px;color:#d2b46f}.autoHead span{display:block;margin-top:2px;color:#6f685f;font-size:7.5px}.autoRefresh{border:1px solid #4a3921;background:#19150f;color:#c9a55d;border-radius:7px;padding:6px 8px;font-size:8px;font-weight:800}.autoRefresh:disabled{opacity:.45}.levelGrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:8px}.levelCell{border:1px solid #252627;background:#101112;border-radius:9px;padding:8px}.levelCell span{display:block;color:#777168;font-size:7.5px}.levelCell b{display:block;margin-top:3px;font-size:11px}.levelCell small{display:block;margin-top:3px;color:#6c665e;font-size:7px}.autoAdopt{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:7px}.autoCheck{display:flex;align-items:center;gap:6px;min-height:34px;padding:6px 7px;border:1px solid #292a2b;border-radius:8px;color:#9b9183;font-size:8px}.autoCheck input{accent-color:#d6aa52}.autoCheck strong{margin-left:auto;color:#c5a359;font-size:8px;white-space:nowrap}.autoNote{min-height:11px;margin-top:5px;color:#665f57;font-size:7px;text-align:center;line-height:1.4}
.calcPriceHint{display:block;min-height:10px;margin:3px 2px 0;color:#6e685f;font-size:7px}.calcResult{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:9px}.calcCell{background:#0b0c0d;border:1px solid #262729;border-radius:9px;padding:8px;min-width:0}.calcCell span{display:block;color:#746d64;font-size:7.5px;font-weight:800}.calcCell b{display:block;margin-top:3px;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.calcProfit{color:var(--up)}.calcLoss{color:var(--down)}.calcGold{color:var(--gold2)}
.calcMsg{min-height:14px;margin-top:7px;font-size:8px;color:#777168;text-align:center;line-height:1.4}.calcMsg.bad{color:#e1a65f}.calcNote{font-size:7.5px;color:#5f5a54;text-align:center;margin-top:5px;line-height:1.45}.calcSelected{color:#c9a55d}.pos[data-calc-entry]{cursor:pointer}
.bottomMaster{margin-top:12px;border:1px solid #302a20;border-radius:13px;background:#101111;padding:11px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}.bottomMasterText b{display:block;color:#d5c5a3;font-size:11px}.bottomMasterText span{display:block;color:#746d64;font-size:8px;margin-top:3px}.masterWrap{display:flex;align-items:center;gap:8px}.masterCount{font-size:9px;color:#a99b82}



.testTrendTag{font-size:8px;font-weight:950;border-radius:999px;padding:3px 7px;border:1px solid #343638;background:#111314;color:#9a9389;white-space:nowrap}.testTrendTag.strong{border-color:#765d2a;background:#1b1710;color:#efc76f}.testTrendTag.continuing{border-color:#6b4b22;background:#21170c;color:#ffbd59}.testTrendTag.weakening{border-color:#713535;background:#211111;color:#ff8383}.testTrendTag.recovering{border-color:#2e5e4a;background:#0e1d17;color:#72e1ae}.testTrendTag.confirmed{border-color:#4c5154;color:#c4beb5}.testTrendTag.win{border-color:#245b42;background:#0d1d16;color:#72dfa8}.testTrendTag.invalid{border-color:#713535;background:#211111;color:#ff8080}
@media(max-width:420px){.calcGrid{grid-template-columns:1.05fr .72fr 1fr;gap:5px}.calcPositionPick select{font-size:13px}.calcAutoGrid .calcField input{padding:0 6px;font-size:13px}.calcLead{grid-template-columns:1fr .66fr 1fr;gap:5px}.calcLead .calcField input{padding:0 6px;font-size:14px}.calcPrices{gap:5px}.calcPrices .calcField input{padding:0 6px;font-size:14px}.calcResult{grid-template-columns:repeat(2,1fr)}.autoAdopt{grid-template-columns:1fr}.levelCell b{font-size:10px}}


.sectionBar{display:flex;align-items:center;justify-content:space-between;margin:10px 3px 7px}
.sectionTitle{font-size:13px;color:#d5c5a3;font-weight:820}

.traderCard{
  margin:9px 0;padding:13px;border:1px solid #473720;border-radius:17px;
  background:linear-gradient(145deg,rgba(26,26,25,.98),rgba(12,13,14,.98));
  box-shadow:0 8px 22px rgba(0,0,0,.18)
}
.traderTop{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.traderMain{min-width:0;flex:1}
.nameLine{display:flex;align-items:center;gap:6px;flex-wrap:wrap;min-width:0}
.traderName{font-size:17px;font-weight:860;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.customTag{
  border:1px solid #715525;background:#16130e;color:#d5aa56;border-radius:7px;
  padding:3px 7px;font-size:9px;font-weight:850;cursor:pointer
}
.customTag.empty{color:#766a54;border-color:#4b4234;background:#101111}

.stateLine{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:6px}
.statusBadge{background:#25221b;color:#d4b979}
.statusBadge.reduce{background:#123823;color:#63e39c}
.statusBadge.long{background:#481c1d;color:#ff7778}
.statusBadge.close{background:#392d18;color:#e9bf69}
.confidenceBadge.high{background:#332a17;color:#e8c675}.confidenceBadge.medium{background:#25231d;color:#bdb189}.confidenceBadge.low{background:#221d1c;color:#a88672}
.signalBadge{display:inline-block;border-radius:6px;padding:3px 6px;font-size:9px;font-weight:900;border:1px solid #3d3528;background:#171613;color:#a99c82}.signalBadge.high{border-color:#8a6226;background:#2a2112;color:#f0c86c}.signalBadge.medium{border-color:#5b4b2b;background:#201d16;color:#d8bf83}.signalBadge.low{border-color:#433532;background:#1e1716;color:#b78d84}.signalBadge.wait{border-color:#343434;background:#171717;color:#888}
.stateInfo{font-size:9px;color:#746f67}
.qualBadge{display:inline-block;border-radius:6px;padding:3px 6px;font-size:9px;font-weight:900;border:1px solid #3b362e}.qualBadge.core{color:#f0c66d;border-color:#765627;background:#2a2012}.qualBadge.qualified{color:#ff7a7c;border-color:#5b292a;background:#291617}.qualBadge.watch{color:#9a948a;border-color:#3b3b3b;background:#171818}
.wideCell{grid-column:1/-1}.rateGuard{margin-top:8px;padding:8px 10px;border-radius:10px;background:#0b0c0c;border:1px solid #242526;color:#79746c;font-size:8px;line-height:1.35}.rateGuard.ok{color:#6fbf91}.rateGuard.warn{color:#e0b65d}.rateGuard.bad{color:#ff796e}.consensusSetting,.bottomMaster{margin-top:10px;border:1px solid #34302a;border-radius:13px;background:#111212;padding:11px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px}.consensusSettingText,.bottomMasterText{min-width:0}.consensusSettingText b,.bottomMasterText b{display:block;font-size:11px;color:#d6c7aa}.consensusSettingText span,.bottomMasterText span{display:block;font-size:8px;color:#746f67;margin-top:3px;line-height:1.35}.radarCount{font-size:9px;color:#8a8277}.orderSettings{margin-top:10px;border:1px solid #2f302f;border-radius:13px;background:#0e0f0f}.orderSettings>summary{list-style:none;display:flex;justify-content:space-between;padding:11px 12px;color:#aaa398;font-size:10px;font-weight:800;cursor:pointer}.orderSettings>summary::-webkit-details-marker{display:none}.orderList{padding:0 10px 10px}.orderRow{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 2px;border-top:1px solid #232424;font-size:9px;color:#c4beb4}.orderRow b{display:inline-block;width:18px;color:#756e65}.orderRow em{font-style:normal;color:#d6aa50;font-size:8px}.orderBtns{display:flex;gap:5px}.orderBtns button{width:34px;height:30px;border:1px solid #3c3d3d;border-radius:8px;background:#1c1d1d;color:#d8d2c7;font-size:14px}

.dataBadge{display:inline-block;border-radius:6px;padding:3px 6px;font-size:9px;font-weight:850;border:1px solid #3a352c;background:#171715;color:#989188}
.dataBadge.live{border-color:#675027;background:#231d13;color:#dfbd73}
.dataBadge.public{border-color:#4c4738;background:#1d1c18;color:#c5b88f}
.dataBadge.none{border-color:#353535;background:#171717;color:#7d7d7d}
.sourceNote{padding:7px 2px 1px;color:#68635c;font-size:8px;line-height:1.45}

.metrics{
  display:grid;grid-template-columns:repeat(3,1fr);margin-top:9px;
  border:1px solid #262728;border-radius:11px;overflow:hidden;background:#0c0e0f
}
.metric{padding:8px 7px;min-width:0;border-left:1px solid #252628}
.metric:first-child{border-left:0}
.metricLabel{font-size:8px;color:#77736c;white-space:nowrap;margin-bottom:3px}
.metricValue{font-size:13px;font-weight:850;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.metricValue.up{color:var(--up)}.metricValue.down{color:var(--down)}.metricValue.gold{color:#d9b25f}.metricValue.muted{color:#aaa49a}.metricValue.signalValue.high{color:#f0c86c}.metricValue.signalValue.medium{color:#d8bf83}.metricValue.signalValue.low{color:#b78d84}.metricValue.signalValue.wait{color:#888}
.statFoot{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px;font-size:8px;color:#716c64}

.switch{position:relative;display:inline-block;width:47px;height:28px;flex:0 0 auto}
.switch input{opacity:0;width:0;height:0}
.slider{position:absolute;inset:0;border-radius:999px;background:#343434;border:1px solid #444;transition:.18s}
.slider:before{content:"";position:absolute;width:22px;height:22px;left:2px;top:2px;border-radius:50%;background:#fff;transition:.18s}
.switch input:checked+.slider{background:linear-gradient(90deg,#c68f32,#e1b75a);border-color:#dcb056}
.switch input:checked+.slider:before{transform:translateX(19px)}

.positionBox{margin-top:9px;border:1px solid #252628;border-radius:11px;overflow:hidden;background:#0c0e0f}
.pos{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(90px,.9fr) minmax(92px,1fr);gap:0;align-items:stretch;padding:0;border-top:1px solid #202224}
.pos:first-child{border-top:0}
.symline{display:flex;align-items:center;gap:7px;min-width:0;padding:10px 9px}.sym{font-size:13px;font-weight:800}
.dirTag{font-size:9px;font-weight:900;padding:3px 6px;border-radius:6px;flex:0 0 auto}.openAt{font-size:7px;color:#756f66;white-space:nowrap;flex:0 0 auto}
.dirTag.long{background:#481c1d;color:#ff7778}.dirTag.short{background:#123823;color:#63e39c}
.posPnl{min-width:0;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;padding:10px 7px;line-height:1.08;border-left:1px solid #252628}
.posPnl .pnlPct{font-size:11px;font-weight:900;white-space:nowrap;line-height:1.15}
.posPnl.profit{color:var(--up)}.posPnl.loss{color:var(--down)}.posPnl.flat{color:var(--gold2)}
.entryWrap{min-width:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center;gap:5px;padding:10px 9px;border-left:1px solid #252628}.entryLabel{font-size:8px;color:#6f6a62;line-height:1;white-space:nowrap;text-align:right}.price{font-size:14px;font-weight:790;text-align:right;white-space:nowrap;line-height:1}.red{color:var(--up)!important}.green{color:var(--down)!important}.gold{color:var(--gold2)!important}
.warnText{color:var(--bad)!important}.pullbackLine{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:8px;padding:7px 9px;border-top:1px solid #202224;background:#0a0c0d;color:#9b9386;font-size:8px;line-height:1.35}.pullbackCopy{min-width:0;display:flex;flex-direction:column;gap:2px}.pullbackCopy b{font-size:9px;line-height:1.15;color:currentColor}.pullbackCopy span{min-width:0}.pullbackLine button{flex:0 0 auto;border:0;color:#181108;background:linear-gradient(90deg,#c68f32,#e3b95d);border-radius:7px;padding:5px 8px;font-size:8px;text-decoration:none;font-weight:900}.pullbackLine.active,.pullbackLine.normal{color:#d8bc7d}.pullbackLine.deep{color:#edc46e}.pullbackLine.invalid,.pullbackLine.paused{color:var(--bad)}.pullbackLine.syncing,.pullbackLine.waiting{color:#858078}.tvAppHint{display:none;position:fixed;left:50%;bottom:max(18px,env(safe-area-inset-bottom));z-index:60;transform:translateX(-50%);width:max-content;max-width:calc(100vw - 28px);align-items:center;gap:10px;padding:9px 10px 9px 12px;border:1px solid #5b4322;border-radius:12px;background:#151616;color:#d7d0c5;font-size:9px;box-shadow:0 8px 28px #000}.tvAppHint.show{display:flex}.tvAppHint button{border:0;border-radius:7px;padding:6px 9px;background:linear-gradient(90deg,#c68f32,#e3b95d);color:#181108;font-size:9px;font-weight:900}
.hidden{display:none!important}
.moreBtn{width:100%;border:0;border-top:1px solid #202224;background:#0c0e0f;color:#938b7e;padding:9px;font-size:9px;font-weight:750}

.details{margin-top:7px;border-top:1px solid #28251f}
.details summary{list-style:none;display:flex;align-items:center;justify-content:space-between;padding:9px 2px 1px;color:#948e84;font-size:9px;cursor:pointer}
.details summary::-webkit-details-marker{display:none}.details summary b{font-weight:780;color:#aaa399}
.event{display:grid;grid-template-columns:40px 1fr auto;gap:6px;align-items:center;padding:7px 2px;border-top:1px solid #222;font-size:10px}.movementPnl{font-size:8px;font-weight:850;white-space:nowrap}.movementPnl.profit{color:var(--up)}.movementPnl.loss{color:var(--down)}.movementPnl.flat{color:var(--gold2)}.eventPnl{display:block;margin-top:2px;font-size:7px;font-weight:800}.details>summary b .movementPnl{margin-left:4px;font-size:8px}
.eventTime{color:#716d66}.eventAct{font-weight:850}.eventCoin{color:#d5d0c7}.eventPx{color:#a49d92;text-align:right}
.statsGrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:8px 0 2px;border-top:1px solid #222}
.statCell{background:#0c0e0f;border:1px solid #252628;border-radius:9px;padding:8px}
.statCell span{display:block;color:#706b63;font-size:8px}.statCell b{display:block;margin-top:3px;font-size:11px}
.emptyText{padding:9px 2px;color:#77716a;font-size:9px}

.settings{margin-top:12px;border:1px solid #493820;border-radius:16px;background:linear-gradient(145deg,#181817,#0c0d0e)}
.settings>summary{list-style:none;display:flex;align-items:center;justify-content:space-between;padding:13px;color:#d3c29f;font-size:12px;font-weight:820;cursor:pointer}
.settings>summary::-webkit-details-marker{display:none}.settingsInner{padding:0 12px 12px}
.types{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.typeChoice input{display:none}
.typeChoice span{display:block;text-align:center;padding:8px 2px;border-radius:8px;border:1px solid #483720;color:#a18f6d;font-size:9px;font-weight:850;background:#111}
.typeChoice input:checked+span{background:linear-gradient(90deg,#c68f32,#e3b95d);color:#161108;border-color:#e1b75a}
button.action{width:100%;border:0;border-radius:10px;padding:11px;margin-top:8px;font-size:12px;font-weight:850}
#subscribe{background:linear-gradient(90deg,#c68f32,#e4ba60);color:#151108}
#test,#testPullback{background:#222426;color:#e4dfd5;border:1px solid #363738}
.msg{min-height:13px;color:#878078;font-size:9px;text-align:center;margin-top:6px}
.note{font-size:8px;color:#66615a;margin-top:7px;line-height:1.45}

.modalBackdrop{display:none;position:fixed;inset:0;background:rgba(0,0,0,.68);z-index:30;align-items:flex-end;justify-content:center}
.modalBackdrop.show{display:flex}
.sheet{width:min(680px,100%);background:#151616;border:1px solid #5b4322;border-radius:20px 20px 0 0;padding:16px 14px max(16px,env(safe-area-inset-bottom))}
.sheetTitle{font-size:16px;font-weight:850;color:#e0bd73}.sheetSub{font-size:10px;color:#777168;margin-top:4px}
.sheet input{width:100%;margin-top:12px;background:#0c0e0f;color:#fff;border:1px solid #3b3b3b;border-radius:11px;padding:12px;font-size:16px;outline:none}
.sheet input:focus{border-color:#c99a45}
.sheetActions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.sheetActions button{border:0;border-radius:10px;padding:12px;font-weight:850}
#labelCancel{background:#272829;color:#ddd}.save{background:linear-gradient(90deg,#c68f32,#e4ba60);color:#151108}




@media(max-width:420px){.types{grid-template-columns:repeat(3,1fr)}.pos{grid-template-columns:minmax(0,1.05fr) minmax(88px,.9fr) minmax(90px,1fr)}.symline{padding:10px 8px;gap:6px}.sym{font-size:12px}.entryWrap{padding:10px 8px;gap:5px}.entryLabel{font-size:7px}.price{font-size:13px}.posPnl{min-width:0;padding:10px 6px}.posPnl .pnlPct{font-size:10px}}

.pageTabs{position:sticky;top:0;z-index:20;display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin:0 -2px 14px;padding:8px 2px;background:transparent;backdrop-filter:none}
.pageTab{border:1px solid #34302a;background:rgba(16,17,18,.38);color:#8d877e;border-radius:10px;padding:9px 5px;font-size:11px;font-weight:850}.pageTab.active{border-color:#8a6529;background:rgba(111,81,34,.24);color:#e5c170}
.page{display:none}.page.active{display:block}
.flowHero{border:1px solid #5c4525;border-radius:16px;background:linear-gradient(145deg,#1b1813,#0c0e0f);padding:14px;margin:6px 0 12px}.flowHeroTop{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.flowHeroTitle{font-size:20px;font-weight:900}.flowHeroTitle.long{color:#ff7778}.flowHeroTitle.short{color:#63e39c}.flowHeroTitle.neutral{color:#d7c38b}.flowHeroMeta{font-size:10px;color:#857e74;margin-top:5px}.flowConfidence{text-align:right;font-size:22px;font-weight:900;color:#e5bd68}.flowConfidence small{display:block;font-size:8px;color:#777168;margin-top:2px}.flowStats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}.flowStat{border:1px solid #292a2b;background:#0d0f10;border-radius:10px;padding:9px}.flowStat span{display:block;font-size:8px;color:#746d64}.flowStat b{display:block;margin-top:3px;font-size:13px}.marketList{display:grid;gap:8px}.marketRow{display:grid;grid-template-columns:minmax(86px,1.1fr) .9fr 1fr;gap:8px;align-items:center;border:1px solid #2c2d2e;border-radius:12px;background:#0e1011;padding:10px}.marketSym{font-size:15px;font-weight:900}.marketSub{font-size:8px;color:#746e66;margin-top:3px}.marketMetric{text-align:right}.marketMetric span{display:block;font-size:8px;color:#746d64}.marketMetric b{display:block;margin-top:2px;font-size:11px}.longText{color:#ff7778}.shortText{color:#63e39c}.goldText{color:#e1ba68}.staleNote{display:none;margin:0 0 10px;padding:8px 10px;border:1px solid #594828;border-radius:10px;background:#17140f;color:#d2ad61;font-size:9px}.staleNote.show{display:block}
.recGrid{display:grid;gap:9px}.recCard{border:1px solid #32302b;border-radius:14px;background:linear-gradient(145deg,#151616,#0c0e0f);padding:12px}.recTop{display:flex;justify-content:space-between;align-items:center;gap:10px}.recSymbolWrap{display:flex;align-items:center;gap:7px;min-width:0}.recSymbol{font-size:17px;font-weight:900}.tvMini{flex:0 0 auto;border:1px solid #5a4728;background:#16130e;color:#d7ae5b;border-radius:7px;padding:5px 7px;font-size:8px;font-weight:900;line-height:1;cursor:pointer}.tvMini:active{transform:translateY(1px)}.recTag{border-radius:8px;padding:5px 8px;font-size:10px;font-weight:900}.recTag.long{background:#481c1d;color:#ff7778}.recTag.short{background:#123823;color:#63e39c}.recScore{margin-top:9px;display:flex;justify-content:space-between;align-items:center;color:#8f877b;font-size:9px}.recScore b{font-size:15px;color:#e2bb67}.recReason{margin-top:5px;color:#777168;font-size:9px;line-height:1.45}.pageIntro{margin:0 2px 10px;color:#817a70;font-size:10px;line-height:1.45}.loadingBox{padding:18px 4px;color:#827b72;font-size:11px}.todayHero{border:1px solid #5c4525;border-radius:16px;background:linear-gradient(145deg,#1b1813,#0c0e0f);padding:14px;margin:6px 0 12px}.todayHeroTop{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.todayHeroTitle{font-size:24px;font-weight:900}.todayHeroTitle.long{color:#ff7778}.todayHeroTitle.short{color:#63e39c}.todayHeroTitle.neutral{color:#e3c27e}.todayHeroMeta{font-size:11px;color:#857e74;margin-top:5px;line-height:1.45}.todayScore{text-align:right;font-size:24px;font-weight:900;color:#e5bd68}.todayScore small{display:block;font-size:8px;color:#777168;margin-top:2px}.todayBar{position:relative;height:14px;border-radius:999px;background:linear-gradient(90deg,#4fd58a 0%,#d0c04c 50%,#ff8a65 100%);margin-top:12px}.todayKnob{position:absolute;top:50%;transform:translate(-50%,-50%);width:22px;height:22px;border-radius:50%;background:#f0eee9;border:3px solid #121314;box-shadow:0 0 0 2px rgba(0,0,0,.25)}.todayAxis{display:flex;justify-content:space-between;margin-top:8px;font-size:9px;color:#9b9388}.todayBiasGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}.biasCard{border:1px solid #2a2c2d;background:#101213;border-radius:12px;padding:9px 5px;text-align:center;cursor:pointer;min-width:0}.biasCard .label{display:block;font-size:10px;font-weight:900;white-space:nowrap}.biasCard .count{display:block;margin-top:4px;font-size:21px;font-weight:900}.biasCard .sub{display:block;margin-top:3px;font-size:8px;color:#777168;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.biasCard.active{border-color:#80602d;background:#17140f}.biasCard.long .label,.biasCard.long .count{color:#ff7448}.biasCard.longWatch .label,.biasCard.longWatch .count{color:#e0b95c}.biasCard.shortWatch .label,.biasCard.shortWatch .count{color:#75cda0}.biasCard.short .label,.biasCard.short .count{color:#28c89b}.biasListPanel{margin-top:8px;border:1px solid #2c2e2f;border-radius:13px;background:#0e1011;overflow:hidden}.biasListHead{display:flex;align-items:center;gap:8px;padding:10px 10px;border-bottom:1px solid #222526}.biasListHeadMain{display:flex;align-items:center;gap:8px;min-width:0}.biasDot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}.biasDot.long{background:#f56d38}.biasDot.longWatch{background:#e0b95c}.biasDot.shortWatch{background:#75cda0}.biasDot.short{background:#28c89b}.biasListTitle{font-size:15px;font-weight:900}.biasListMeta{font-size:8px;color:#777168;margin-top:2px}.biasListRows{display:grid}.biasRow{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:7px;align-items:center;padding:9px 10px;border-top:1px solid #1f2223}.biasRank{font-size:12px;color:#8e887e;text-align:center}.biasNameCell{min-width:0}.biasName{font-size:14px;font-weight:900}.biasExtra{font-size:9px;color:#6f6961;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.biasMetrics{text-align:right}.biasChange{display:block;font-size:13px;font-weight:900}.biasFlow{display:block;margin-top:2px;font-size:9px}.biasRow.long .biasChange,.biasRow.long .biasFlow{color:#ff7448}.biasRow.longWatch .biasChange,.biasRow.longWatch .biasFlow{color:#e0b95c}.biasRow.shortWatch .biasChange,.biasRow.shortWatch .biasFlow{color:#75cda0}.biasRow.short .biasChange,.biasRow.short .biasFlow{color:#28c89b}.matrixWrap{margin-top:10px}.matrixTitle{display:flex;align-items:center;justify-content:space-between;margin:0 2px 6px}.matrixTitle b{font-size:11px;color:#c8b68e}.matrixTitle span{font-size:8px;color:#6f6961}.miniMatrix{display:grid;grid-template-columns:1fr 1fr;gap:6px}.matrixCell{border:1px solid #292c2d;border-radius:11px;background:#0e1011;padding:7px;min-width:0}.matrixHead{display:flex;align-items:center;justify-content:space-between;gap:5px;margin-bottom:5px}.matrixHead b{font-size:10px}.matrixHead small{font-size:7px;color:#68635d}.matrixCell.long .matrixHead b{color:#ff7448}.matrixCell.longWatch .matrixHead b{color:#e0b95c}.matrixCell.shortWatch .matrixHead b{color:#75cda0}.matrixCell.short .matrixHead b{color:#28c89b}.matrixCoins{display:grid;gap:4px}.matrixCoin{width:100%;min-height:42px;border:1px solid #2d3031;border-radius:8px;background:#131516;color:#ddd;padding:5px 7px;display:flex;align-items:center;justify-content:space-between;gap:5px;cursor:pointer;text-align:left}.matrixCoin b{font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.matrixCoin span{font-size:9px;font-weight:850;white-space:nowrap}.matrixCell.long .matrixCoin span{color:#ff7448}.matrixCell.longWatch .matrixCoin span{color:#e0b95c}.matrixCell.shortWatch .matrixCoin span{color:#75cda0}.matrixCell.short .matrixCoin span{color:#28c89b}.matrixEmpty{min-height:42px;display:flex;align-items:center;color:#56524c;font-size:9px}.tvNameLink{background:none;border:0;padding:0;color:inherit;font:inherit;font-weight:900;cursor:pointer;text-align:left}.tvNameLink:hover{text-decoration:underline;text-underline-offset:2px}

.briefControls{display:grid;grid-template-columns:auto 1fr auto;gap:7px;align-items:center;margin:6px 0 2px}.briefControls select,.briefControls button{height:34px;border:1px solid #313334;border-radius:9px;background:#101213;color:#d9d2c6;font-size:9px;font-weight:800;padding:0 8px}.briefNotifyWrap{display:flex;align-items:center;justify-content:flex-end;gap:6px;font-size:9px;color:#9a9287}.briefMsg{min-height:11px;margin:2px 2px 7px;color:#6f6961;font-size:8px}.briefBullets{margin:9px 0 0;padding:0;list-style:none;display:grid;gap:5px}.briefBullets li{font-size:12px;line-height:1.55;color:#d6cec1;padding-left:10px;position:relative}.briefBullets li::before{content:"·";position:absolute;left:0;color:#d5aa56}.briefAction{margin-top:10px;padding-top:9px;border-top:1px solid #2b2925;font-size:12px;font-weight:850;color:#e0c37c;line-height:1.45}.briefSources{display:none}.rankCard{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid #303234;border-radius:13px;background:#0e1011;padding:10px}.rankNo{font-size:14px;font-weight:900;color:#8f887d;text-align:center}.rankMain{min-width:0}.rankTop{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.rankSymbol{font-size:15px}.rankReason{margin-top:4px;font-size:9px;color:#9a9287;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rankMini{margin-top:4px;font-size:8px;color:#6e685f;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rankWin{text-align:right;min-width:60px}.rankWin b{display:block;font-size:17px;color:#e6bd67}.rankWin span{display:block;font-size:8px;color:#746d64}.rankWin small{display:block;margin-top:3px;font-size:8px;color:#91897d}.ideaNote{margin:0 2px 9px;color:#6d675f;font-size:8px;line-height:1.4}



.testToolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:3px 1px 10px}.testToolbarLeft{min-width:0}.testToolbarTitle{font-size:12px;font-weight:900;color:#d8c59a}.testToolbarSub{margin-top:2px;font-size:8px;color:#756f67;line-height:1.4}.testNotify{display:flex;align-items:center;gap:7px;flex:0 0 auto;color:#9d958a;font-size:9px;font-weight:800}.testSummary{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-bottom:9px}.testSummaryCell{border:1px solid #2d3031;border-radius:11px;background:#0e1011;padding:8px 6px;text-align:center;min-width:0}.testSummaryCell span{display:block;font-size:8px;color:#756f67;white-space:nowrap}.testSummaryCell b{display:block;margin-top:4px;font-size:15px;color:#e0bc6d;white-space:nowrap}.testGrid{display:grid;gap:9px}.testCard{border:1px solid #303235;border-radius:15px;background:linear-gradient(145deg,#121415,#0c0e0f);padding:11px}.testCard.confirmed{border-color:#765f2d;background:linear-gradient(145deg,#1a1711,#0c0e0f)}.testCard.win{border-color:#22583c}.testCard.loss,.testCard.invalid{border-color:#6c2f2f}.testHead{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:8px;align-items:center}.testRank{font-size:13px;font-weight:900;color:#80796f;text-align:center}.testSymbolRow{display:flex;align-items:center;gap:7px;min-width:0;flex-wrap:wrap}.testSymbol{font-size:17px;font-weight:950}.testDir{font-size:9px;font-weight:900;border-radius:7px;padding:4px 7px}.testDir.long{background:#4a1d1d;color:#ff7b7b}.testDir.short{background:#123a25;color:#63e39c}.testState{text-align:right;min-width:70px}.testState b{display:block;font-size:12px;color:#e3c476}.testState small{display:block;margin-top:2px;font-size:8px;color:#716a62}.testQuality{margin-top:9px;display:flex;align-items:center;gap:8px}.testQualityBar{height:7px;flex:1;border-radius:999px;background:#242729;overflow:hidden}.testQualityFill{height:100%;border-radius:999px;background:linear-gradient(90deg,#685129,#e1b75d)}.testQualityText{font-size:9px;color:#9a9287;white-space:nowrap}.testQualityText b{font-size:13px;color:#e0bd6d}.testMetrics{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:9px}.testMetric{border:1px solid #26292a;border-radius:9px;background:#101213;padding:7px 5px;text-align:center;min-width:0}.testMetric span{display:block;font-size:7px;color:#756f67;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.testMetric b{display:block;margin-top:3px;font-size:12px;color:#d9d2c7;white-space:nowrap}.testLevels{margin-top:8px;padding:8px 9px;border-radius:10px;background:#0b0d0e;border:1px solid #242728;display:grid;grid-template-columns:1fr 1fr;gap:6px 10px}.testLevel{min-width:0}.testLevel span{display:block;font-size:7px;color:#6f6961}.testLevel b{display:block;margin-top:2px;font-size:11px;color:#cfc7bb;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.testReasons{margin-top:8px;display:flex;gap:5px;flex-wrap:wrap}.testReason{font-size:8px;color:#9c9488;border:1px solid #2a2d2e;background:#101213;border-radius:999px;padding:4px 6px}.testActions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.testActions button{height:34px;border-radius:9px;border:1px solid #343638;background:#121415;color:#cfc7bb;font-size:9px;font-weight:900;padding:0 10px;min-width:0}.testActions .monitorBtn{border-color:#695126;color:#e0bd6d}.testActions .openTvBtn{border-color:#3d505c;color:#9dc7df}.testEmpty{padding:22px 4px;text-align:center;color:#777068;font-size:10px}.testMethod{margin:10px 2px 0;color:#665f57;font-size:8px;line-height:1.5}.testFocusPanel{display:none;border:1px solid #554424;border-radius:14px;background:linear-gradient(145deg,#15140f,#0c0e0f);padding:10px;margin:0 0 11px}.testFocusPanel.show{display:block}.testMonitorHeader{display:flex;align-items:center;justify-content:space-between;gap:9px;margin-bottom:8px}.testMonitorHeadLeft{min-width:0}.testMonitorTitle{font-size:14px;font-weight:950;color:#e1bf73}.testMonitorSub{margin-top:2px;font-size:8px;color:#777066}.testMonitorControls{display:flex;gap:5px;flex:0 0 auto}.testMonitorControls button{height:27px;border:1px solid #343638;border-radius:8px;background:#101213;color:#928b81;font-size:8px;font-weight:900;padding:0 7px}.testMonitorList{display:grid;gap:6px}.testMonitorItem{border:1px solid #2e3031;border-radius:11px;background:#0e1011;overflow:hidden}.testMonitorItem.focused{border-color:#7a5c29}.testMonitorItem summary{list-style:none;cursor:pointer;padding:9px 10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}.testMonitorItem summary::-webkit-details-marker{display:none}.testMonitorSummaryMain{min-width:0;display:flex;align-items:center;gap:7px;flex-wrap:wrap}.testMonitorSymbol{font-size:14px;font-weight:950;color:#ded6ca}.testMonitorDir{font-size:8px;font-weight:900;border-radius:6px;padding:3px 6px}.testMonitorDir.long{background:#461d1d;color:#ff7a7a}.testMonitorDir.short{background:#123923;color:#63e39c}.testMonitorState{font-size:8px;color:#8b8379}.testMonitorEventTime{font-size:8px;color:#b0a79b;font-variant-numeric:tabular-nums;white-space:nowrap}.testMonitorSummaryScore{text-align:right;white-space:nowrap}.testMonitorSummaryScore b{display:block;font-size:13px;color:#e0bb68}.testMonitorSummaryScore span{display:block;font-size:7px;color:#746d64}.testMonitorBody{padding:0 10px 10px;border-top:1px solid #242627}.testFocusBody{margin-top:8px;display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.testFocusCell{border-top:1px solid #2c2a26;padding-top:6px;min-width:0}.testFocusCell span{display:block;font-size:7px;color:#756e64}.testFocusCell b{display:block;margin-top:2px;font-size:11px;color:#d8d0c3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.testFocusMeta{margin-top:7px;font-size:8px;color:#8f877d;line-height:1.45}.testFocusActions{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:9px}.testFocusActions button{height:34px;border:1px solid #3b3d3e;border-radius:9px;background:#121415;color:#d3cbc0;font-size:9px;font-weight:900;padding:0 11px}.testFocusActions .openTv{border-color:#7b5c29;color:#e2bd69}.testFocusActions .closeJudge{border-color:#37393a;color:#9a9389}

@media(max-width:420px){.wrap{padding-left:12px;padding-right:12px}.brandTitle{font-size:25px}.brandSub{font-size:12px}.sectionTitle{font-size:15px}.traderName{font-size:18px}.stateInfo,.consensusMeta,.note{font-size:9px}.pageTab{font-size:10px;padding:10px 2px}.flowHeroTitle{font-size:22px}.flowStats{grid-template-columns:1fr 1fr}.marketRow{grid-template-columns:minmax(92px,1.1fr) .9fr .9fr;padding:11px 9px;gap:6px}.marketSym{font-size:16px}.marketMetric b{font-size:12px}.recSymbol{font-size:18px}.recTag{font-size:11px}.todayHeroTitle{font-size:23px}.todayScore{font-size:23px}.todayBiasGrid{grid-template-columns:repeat(4,1fr);gap:5px}.biasCard{padding:8px 2px}.biasCard .label{font-size:9px}.biasCard .count{font-size:19px}.biasCard .sub{display:none}.biasRow{grid-template-columns:24px minmax(0,1fr) auto;padding:8px 8px}.biasExtra{font-size:7px}.miniMatrix{gap:5px}.matrixCell{padding:6px}.matrixCoin{min-height:40px;padding:4px 6px}.matrixCoin b{font-size:9px}.matrixCoin span{font-size:8px}.briefControls{grid-template-columns:auto 1fr auto}.briefNotifyWrap{justify-content:flex-end}.rankCard{grid-template-columns:24px minmax(0,1fr) auto;padding:9px 8px}.rankWin b{font-size:15px}.testSummary{gap:5px}.testSummaryCell{padding:7px 3px}.testSummaryCell b{font-size:13px}.testMetric b{font-size:11px}.testCard{padding:10px 9px}.testSymbol{font-size:16px}.testFocusBody{grid-template-columns:repeat(3,1fr)}.testMonitorControls button{padding:0 6px}.testMonitorSymbol{font-size:13px}}

.briefSchedule{display:inline-flex;align-items:center;color:#756f67;font-size:7.5px;font-weight:750;white-space:nowrap;padding:0 2px}</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div>
      <div class="brandTitle">交易監控</div>
      <div class="brandSub">高訊號倉位 · 自動回踩通知</div>
    </div>
    <div class="sync">
      <div class="syncMain"><span id="dot" class="dot"></span><span id="status">連線中</span></div>
      <div id="syncAge" class="syncSub">同步中</div>
    </div>
  </div>

  <div class="pageTabs" role="tablist"><button class="pageTab active" data-page="today" type="button">今日</button><button class="pageTab" data-page="monitor" type="button">監控</button><button class="pageTab" data-page="flow" type="button">市場流向</button><button class="pageTab" data-page="ideas" type="button">建議</button><button class="pageTab" data-page="test" type="button">測試</button></div>

  <section id="page-today" class="page active">
    <div class="sectionBar"><div class="sectionTitle">今日</div><div id="todayAge" class="radarCount">—</div></div>
    <div id="todayHero" class="loadingBox">讀取中…</div>
    <div class="briefControls"><div class="briefSchedule">每日 08:05</div><div class="briefNotifyWrap"><span>通知</span><label class="switch"><input id="briefNotify" type="checkbox"><span class="slider"></span></label></div><button id="briefRefresh" type="button">手動更新</button></div>
    <div id="briefMsg" class="briefMsg"></div>
    <div id="todayBiases" class="todayBiasGrid"><div class="loadingBox">整理中…</div></div>
    <div id="todayBiasList" class="biasListPanel"><div class="loadingBox">整理中…</div></div>
    <div class="matrixWrap">
      <div id="matrixChart" class="miniMatrix"><div class="loadingBox">整理中…</div></div>
    </div>
  </section>

  <section id="page-monitor" class="page">
  <div id="testFocusPanel" class="testFocusPanel"></div>
  <div id="latest" class="latest"></div>
  <div id="consensusPanel" class="consensusPanel"></div>

  <details id="tradeCalc" class="tradeCalc">
    <summary><span>⚡ 跟單 / 盈損試算</span><span class="tradeCalcHint">自動區間 · 最大虧損 · TP / SL　⌄</span></summary>
    <div class="tradeCalcBody">
      <div class="calcPositionPick">
        <div class="calcField"><label for="calcPosition">選擇目前監控倉位</label><select id="calcPosition"><option value="">目前沒有可選倉位</option></select></div>
      </div>
      <div class="calcGrid calcAutoGrid">
        <div class="calcField"><label for="calcSymbol">標的</label><input id="calcSymbol" type="text" value="—" readonly></div>
        <div class="calcField"><label for="calcSideLabel">方向</label><input id="calcSideLabel" type="text" value="—" readonly></div>
        <input id="calcSide" type="hidden" value="LONG">
        <div class="calcField"><label for="calcEntry">進場位</label><input id="calcEntry" type="text" value="—" readonly></div>
      </div>

      <div class="calcModeRow">
        <div class="calcField"><label for="calcMode">試算方式</label><select id="calcMode"><option value="MARGIN">固定保證金</option><option value="MAX_LOSS">固定最大虧損</option></select></div>
      </div>
      <div class="calcLead">
        <div class="calcField"><label for="calcMargin">保證金 U</label><input id="calcMargin" inputmode="decimal" type="number" min="0" step="1" placeholder="300"></div>
        <div class="calcField"><label for="calcLev">槓桿</label><input id="calcLev" inputmode="numeric" type="number" min="1" max="125" step="1" placeholder="20"></div>
        <div class="calcField"><label for="calcMaxLoss">最大虧損 U</label><input id="calcMaxLoss" inputmode="decimal" type="number" min="0" step="1" placeholder="100" disabled></div>
      </div>

      <div class="autoLevels">
        <div class="autoHead"><div><b>自動參考 TP / SL</b><span>Binance 15分結構 + ATR14 · 僅供參考</span></div><button id="autoRefresh" class="autoRefresh" type="button">重新抓</button></div>
        <div class="levelGrid">
          <div class="levelCell"><span>TP 參考區間</span><b id="autoTpRange" class="calcProfit">—</b><small id="autoTpPct">等待選倉位</small></div>
          <div class="levelCell"><span>SL 參考區間</span><b id="autoSlRange" class="calcLoss">—</b><small id="autoSlPct">等待選倉位</small></div>
        </div>
        <div class="autoAdopt">
          <label class="autoCheck"><input id="useAutoTp" type="checkbox"><span>採用建議 TP</span><strong id="autoTpSuggested">—</strong></label>
          <label class="autoCheck"><input id="useAutoSl" type="checkbox"><span>採用建議 SL</span><strong id="autoSlSuggested">—</strong></label>
        </div>
        <div id="autoNote" class="autoNote">選倉位後會自動抓一次；你仍可手動輸入。</div>
      </div>

      <div class="calcPrices">
        <div class="calcField"><label for="calcTp">TP 點位</label><input id="calcTp" inputmode="decimal" type="number" min="0" step="any" placeholder="可手動輸入"><small id="calcTpMove" class="calcPriceHint">—</small></div>
        <div class="calcField"><label for="calcSl">SL 點位</label><input id="calcSl" inputmode="decimal" type="number" min="0" step="any" placeholder="可手動輸入"><small id="calcSlMove" class="calcPriceHint">—</small></div>
      </div>

      <div class="calcResult" aria-live="polite">
        <div class="calcCell"><span id="calcMarginResultLabel">使用保證金</span><b id="calcMarginResult" class="calcGold">—</b></div>
        <div class="calcCell"><span>總倉位</span><b id="calcNotional" class="calcGold">—</b></div>
        <div class="calcCell"><span>預估數量</span><b id="calcQty" class="calcGold">—</b></div>
        <div class="calcCell"><span>TP 價格變動</span><b id="calcPriceProfitPct" class="calcProfit">—</b></div>
        <div class="calcCell"><span>SL 價格變動</span><b id="calcPriceLossPct" class="calcLoss">—</b></div>
        <div class="calcCell"><span>RR</span><b id="calcRR" class="calcGold">—</b></div>
        <div class="calcCell"><span>TP 預估獲利</span><b id="calcProfit" class="calcProfit">—</b></div>
        <div class="calcCell"><span>SL 預估虧損</span><b id="calcLoss" class="calcLoss">—</b></div>
        <div class="calcCell"><span>槓桿後 TP / SL</span><b id="calcLeveragedPct" class="calcGold">—</b></div>
      </div>
      <div id="calcMsg" class="calcMsg">選一筆目前倉位開始試算。</div>
      <div class="calcNote">自動 TP/SL 是結構與波動參考，不代表必然有效；試算未含手續費、滑價、資金費與強平因素，也不會送出真實訂單。</div>
    </div>
  </details>

  <div class="sectionBar">
    <div class="sectionTitle">雷達</div><div id="radarCount" class="radarCount">共識合格 —</div>
  </div>

  <div id="traders"><div class="emptyText">讀取中…</div></div>

  <details id="settingsPanel" class="settings">
    <summary><span>🔔 通知設定</span><span>⌄</span></summary>
    <div class="settingsInner">
      <div id="typeOptions" class="types"></div>
      <div class="consensusSetting"><div class="consensusSettingText"><b>熬鷹同向確認</b><span>只有熬鷹與至少 1 位嚴選交易員同幣同方向，才提醒一次</span></div><label class="switch"><input id="consensusToggle" type="checkbox" checked><span class="slider"></span></label></div>
      <div id="rateGuard" class="rateGuard">限流保護：讀取中…</div>
      <button id="subscribe" class="action">同步 iPhone 通知</button>
      <button id="test" class="action">測試通知</button>
      <button id="testPullback" class="action">測試回踩通知 → 監控判讀</button>
      <div id="msg" class="msg"></div>
      <div class="note">熬鷹是唯一主訊號，約 3 秒檢查；佛系撈金大隊長與知危只做同向確認。回踩通知只使用訂單 API 精確首次建倉，先以 15 分 ATR 過濾普通震盪，再用建倉後極值計算一般 38.2%、深度 61.8% 與過深 78.6%；每階段每倉只提醒一次。訂單 API 異常、進場無法精確確認或歷史極值尚未補齊時一律暫停，不用舊資料硬報。通知只叫你開 TradingView 檢查 SMC／POC，不是下單指令。PnL 不含手續費與資金費。</div>
    </div>
  </details>

  <div class="bottomMaster">
    <div class="bottomMasterText"><b>通知開關</b><span>只控制個別交易員通知，不影響「熬鷹同向確認」</span></div>
    <div class="masterWrap"><span id="allCount" class="masterCount">1/3</span><label class="switch"><input id="allToggle" type="checkbox" checked><span class="slider"></span></label></div>
  </div>

  <details class="orderSettings">
    <summary><span>↕ 自訂顯示順序</span><span>熬鷹固定第一　⌄</span></summary>
    <div id="orderList" class="orderList"></div>
  </details>
  </section>

  <section id="page-flow" class="page">
    <div class="sectionBar"><div class="sectionTitle">市場流向</div><div id="flowAge" class="radarCount">等待資料</div></div>
    <div class="pageIntro">Binance USDT 永續公開資料；成交額、24h 漲跌與資金費率只用來判斷當下市場偏向，不取代你的進場結構。</div>
    <div id="flowStale" class="staleNote"></div>
    <div id="flowHero" class="loadingBox">讀取市場中…</div>
    <div class="sectionBar"><div class="sectionTitle">成交額前列</div><div class="radarCount">高流動性優先</div></div>
    <div id="marketList" class="marketList"><div class="loadingBox">讀取中…</div></div>
  </section>

  <section id="page-ideas" class="page">
    <div class="sectionBar"><div class="sectionTitle">建議排名</div><div id="ideaAge" class="radarCount">—</div></div>
    <div class="ideaNote">估算＝多週期技術＋衍生品數據＋近期類似訊號回測</div>
    <div id="recGrid" class="recGrid"><div class="loadingBox">計算中…</div></div>
  </section>

  <section id="page-test" class="page">
    <div class="sectionBar"><div class="sectionTitle">回踩測試</div><div id="testAge" class="radarCount">—</div></div>
    <div class="testToolbar"><div class="testToolbarLeft"><div class="testToolbarTitle">建議標的自動等回踩</div><div class="testToolbarSub">成立後持續通知續強 / 轉弱 / 轉強 / 達標 / 失效 · 點通知先回監控</div></div><div class="testNotify"><span>通知</span><label class="switch"><input id="testSignalNotify" type="checkbox"><span class="slider"></span></label></div></div>
    <div id="testSummary" class="testSummary"><div class="testSummaryCell"><span>監控</span><b>—</b></div><div class="testSummaryCell"><span>回踩中</span><b>—</b></div><div class="testSummaryCell"><span>已確認</span><b>—</b></div><div class="testSummaryCell"><span>實測勝率</span><b>—</b></div></div>
    <div id="testGrid" class="testGrid"><div class="loadingBox">建立回踩模型中…</div></div>
    <div id="testMethod" class="testMethod"></div>
  </section>
</div>

<div id="labelModal" class="modalBackdrop" aria-hidden="true">
  <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <div id="sheetTitle" class="sheetTitle">自訂交易員標籤</div>
    <div class="sheetSub">例如：核心、穩健、攻擊、觀察</div>
    <input id="labelInput" maxlength="10" autocomplete="off" placeholder="輸入標籤">
    <div class="sheetActions">
      <button id="labelCancel" type="button">取消</button>
      <button id="labelSave" class="save" type="button">儲存</button>
    </div>
  </div>
</div>

<script src="/app.js?v=780"></script>
</body>
</html>
